# beaver configuration — copy to config.env (gitignored) and fill in.
#   cp config.env.example config.env && chmod 600 config.env
# Nothing here is committed; keep hosts/paths/secrets in config.env only.

## --- restic encryption -------------------------------------------------------
# Password file for the restic repositories (create it, chmod 600).
RESTIC_PASSWORD_FILE="$HOME/.config/beaver/restic.key"

## --- destinations (leave blank to disable a target) --------------------------
# Each is a restic repository URI. $(hostname) keeps machines separate.
# NAS (unraid) over SFTP, or restic REST server:
NAS_REPO=""        # e.g. sftp:USER@nas.lan:/mnt/user/backups/restic/$(hostname)
                   # or   rest:http://nas.lan:8000/$(hostname)
# External drive (mounted path):
EXTDRIVE_REPO=""   # e.g. /run/media/$USER/BACKUP/restic/$(hostname)
# Cloud (S3 or Backblaze B2):
CLOUD_REPO=""      # e.g. s3:s3.amazonaws.com/BUCKET/$(hostname)
                   # or   b2:BUCKET:$(hostname)

## --- cloud credentials (only if CLOUD_REPO is set) ---------------------------
# Prefer exporting these from a secrets manager; shown here for reference.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# B2_ACCOUNT_ID=""
# B2_ACCOUNT_KEY=""

## --- what to back up ---------------------------------------------------------
BACKUP_PATHS=(
  "$HOME"
)
# Excluded (big / re-downloadable / caches). Edit to taste.
EXCLUDES=(
  "$HOME/.cache"
  "$HOME/.local/share/Trash"
  "$HOME/.local/share/Steam/steamapps"      # game installs - re-download
  "$HOME/.var/app/*/cache"
  "$HOME/Games"                              # Heroic/NSL game installs
  "*/node_modules" "*/.venv" "*/target"
)

## --- retention (restic forget --prune) --------------------------------------
KEEP_DAILY=7
KEEP_WEEKLY=5
KEEP_MONTHLY=12

## --- where state manifests are written (included in the data backup) ---------
STATE_DIR="$HOME/.local/state/beaver"
